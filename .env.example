# OSCAR Environment Configuration
# Copy this file to .env and fill in the providers you want to use.

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider selection
# ─────────────────────────────────────────────────────────────────────────────
# Primary provider OSCAR uses for every chat call. One of:
#   gemini    — Google Gemini (Vertex AI ADC by default; falls back to GEMINI_API_KEY)
#   openai    — OpenAI GPT-5 family
#   anthropic — Anthropic Claude 4.x
#   groq      — Open-source models on Groq LPU hardware
#   ollama    — Local models served by Ollama (no API key required)
OSCAR_LLM_PROVIDER=gemini

# Model id within the chosen provider. Run `oscar providers` to see the full
# catalog. Defaults to each provider's recommended model when unset.
#   gemini    → gemini-2.5-flash | gemini-3.5-flash† | gemini-3.1-pro-preview† |
#               gemini-3.1-flash-lite† | gemini-2.5-pro | gemini-2.5-flash-lite
#               (†) Gemini 3.x is on the Developer API; Vertex AI rollout in progress.
#   openai    → gpt-5.4-mini | gpt-5.5 | gpt-5.5-2026-04-23 | gpt-5.4 |
#               gpt-5.4-nano | o3 | o4-mini | gpt-4.1 | gpt-4o
#   anthropic → claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5-20251001
#   groq      → llama-3.3-70b-versatile | llama-3.1-8b-instant
#   ollama    → llama3.3 | llama3.1 | qwen2.5-coder | deepseek-coder-v2 | mistral-nemo
OSCAR_LLM_MODEL=gemini-2.5-flash

# Fallback provider/model if the primary fails. Optional. Defaults to gemini.
OSCAR_LLM_FALLBACK_PROVIDER=gemini
OSCAR_LLM_FALLBACK_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# Provider credentials (only set the ones you use)
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API key (required when OSCAR_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (required when OSCAR_LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini Developer API key (only needed if you don't use Vertex AI ADC)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (required when OSCAR_LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Vertex AI (used by the gemini provider when ADC auth is configured)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Ollama — defaults to http://localhost:11434/v1. Override only if you run
# Ollama on a different host/port.
# OSCAR_OLLAMA_BASE_URL=http://localhost:11434/v1

# ─────────────────────────────────────────────────────────────────────────────
# Tavily (web search) — dual keys for rate-limit fallback (optional)
# ─────────────────────────────────────────────────────────────────────────────
TAVILY_API_KEY1=your_primary_tavily_key
TAVILY_API_KEY2=your_backup_tavily_key

# ─────────────────────────────────────────────────────────────────────────────
# Application settings
# ─────────────────────────────────────────────────────────────────────────────
OSCAR_LOG_LEVEL=INFO
OSCAR_DATA_DIR=./data
OSCAR_SAFE_MODE=true
OSCAR_DEBUG=false
OSCAR_DRY_RUN=false
